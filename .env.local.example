# Copy this file to .env.local and fill in your own values. Never commit .env.local.
#
# Used server-side only by src/app/api/consultant/route.ts — never sent to the browser.
ANTHROPIC_API_KEY=

# Shared password for the whole application. Verified server-side only
# (src/lib/auth/session.ts, src/middleware.ts) — never sent to the browser.
SITE_PASSWORD=your-secure-password-here
