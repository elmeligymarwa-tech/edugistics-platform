# Copy this file to .env.local and fill in your own values. Never commit .env.local.
#
# Required to run `npm run test` at all — checked by vitest.database-guard.ts
# before any test file loads. Must be set to the exact same value as
# DATABASE_URL: this is a deliberate, explicit confirmation that the
# database DATABASE_URL points at is a dedicated test database, safe for
# tests to create rows in and delete from. If it is unset, or does not match
# DATABASE_URL exactly, the whole test run aborts — a database is never
# assumed safe just because it doesn't look like production. See CLAUDE.md,
# "Test suite writes to the production database".
TEST_DATABASE_URL=

# Used server-side only by src/app/api/consultant/route.ts — never sent to the browser.
ANTHROPIC_API_KEY=

# Shared password for the whole application. Verified server-side only
# (src/lib/auth/session.ts, src/middleware.ts) — never sent to the browser.
SITE_PASSWORD=your-secure-password-here

# Marketing email (the subscriber composer) sends from a separate domain to
# EMAIL_FROM's transactional domain, so a marketing send reported as spam
# never harms registration/course email deliverability. Configure
# news.edugistics.online as its own verified sender in Resend.
# Used server-side only — src/lib/training/email/resend-client.ts.
MARKETING_EMAIL_FROM=Edugistics <updates@news.edugistics.online>

# Optional — the hard cap on recipients for a single marketing campaign send
# (Phase D). Blocks the send server-side above this number regardless of
# what the interface shows. Defaults to 1000 when unset.
# Used server-side only — src/lib/training/email/send-marketing-campaign.ts.
MARKETING_EMAIL_MAX_RECIPIENTS=1000

# Optional — marketing sends per second, throttled independently of the
# transactional bulk-email rate (EMAIL_SEND_RATE_PER_SECOND) even though
# both share the same Resend account quota. Defaults to 2 when unset.
# Used server-side only — src/lib/training/email/send-marketing-campaign.ts.
MARKETING_EMAIL_SEND_RATE_PER_SECOND=2

# Optional — Meta Pixel ID. Public by nature (NEXT_PUBLIC is correct here),
# so no risk in it reaching the browser. When unset, the pixel simply does
# not load and nothing else breaks.
# Loaded only on public pages (/, /training, /training/privacy,
# /unsubscribe) — see src/lib/meta-pixel/config.ts's isPublicTrackedPath
# allowlist, which is what actually keeps it off /training/admin/* and
# /app/*, not where the component is mounted.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side event tracking, deduplicated against the
# browser pixel above by a shared event id) — see
# src/lib/training/meta-capi/send-conversion-event.ts. Server-side only:
# never reference in client code, never prefix with NEXT_PUBLIC.
#
# When unset, CAPI is disabled entirely — the app still works normally, it
# just logs once and sends nothing.
META_CAPI_ACCESS_TOKEN=

# Required for CAPI to send anything at all when DATABASE_URL does not
# resolve to the production project (see database-environment.ts) — without
# it, a non-production environment sends no conversion events rather than
# sending live ones. Get this from Meta Events Manager > Test Events.
META_CAPI_TEST_EVENT_CODE=
