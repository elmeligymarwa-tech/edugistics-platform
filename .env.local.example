# Copy this file to .env.local and fill in your own values. Never commit .env.local.
#
# Used server-side only by src/app/api/consultant/route.ts — never sent to the browser.
ANTHROPIC_API_KEY=

# Shared password for the whole application. Verified server-side only
# (src/lib/auth/session.ts, src/middleware.ts) — never sent to the browser.
SITE_PASSWORD=your-secure-password-here

# Marketing email (the subscriber composer) sends from a separate domain to
# EMAIL_FROM's transactional domain, so a marketing send reported as spam
# never harms registration/course email deliverability. Configure
# news.edugistics.online as its own verified sender in Resend.
# Used server-side only — src/lib/training/email/resend-client.ts.
MARKETING_EMAIL_FROM=Edugistics <updates@news.edugistics.online>
