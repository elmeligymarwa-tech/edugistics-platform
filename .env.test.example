# Copy the three variable names below into .env.test and fill in your own
# values (I create .env.test myself — it's already covered by `.env*` in
# .gitignore, so it's never committed).
#
# Dedicated Supabase project created for testing — must NOT be the
# production project (ref ndkhfqhyuglwtpwlxrxo). Runtime queries (the test
# suite itself) go through the pooled connection; `npm run testdb:migrate`
# needs the direct connection to apply migrations. Same split as
# prisma/schema.prisma's datasource — see its comment.
DATABASE_URL=
DIRECT_URL=

# Must be byte-for-byte identical to DATABASE_URL above. This is the
# explicit opt-in vitest.database-guard.ts requires before it will let any
# test touch this database — see CLAUDE.md, "Test suite writes to the
# production database".
TEST_DATABASE_URL=
