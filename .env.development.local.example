# Copy this to .env.development.local (gitignored, per-machine — I create it
# myself, same as .env.test) and fill in the same credentials as .env.test.
#
# Next.js loads .env.development.local ahead of .env.local whenever
# NODE_ENV=development (i.e. `next dev`), so pointing this at the dedicated
# test Supabase project makes local dev resolve there automatically, with no
# code change — while `next build`/`next start`/Vercel (NODE_ENV=production)
# still resolve through .env.local untouched. See TEST-DATABASE.md, "Local
# development must never resolve to production".
#
# Dedicated Supabase project created for testing — must NOT be the
# production project (ref ndkhfqhyuglwtpwlxrxo).
DATABASE_URL=
DIRECT_URL=
