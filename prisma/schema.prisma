// Training Registration & Analytics — dedicated Supabase Postgres project,
// public schema. Runtime connects via the pooler (url), migrations run
// through the direct connection (directUrl) — never through the pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CourseCategory {
  LEADERSHIP
  TEACHING_LEARNING
  ASSESSMENT
  CURRICULUM
  SEN
  CLASSROOM_MANAGEMENT
  TECHNOLOGY
  AI
  PROFESSIONAL_DEVELOPMENT
}

enum DeliveryMethod {
  ONLINE
  IN_PERSON
  HYBRID
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  CONFIRMED
  WAITLISTED
  PROMOTED
}

enum PromoCodeDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Scopes maxUsesPerTeacher. ALL_COURSES (default, matches pre-Phase-C
// behaviour for every existing code) counts a teacher's CONFIRMED uses of
// this code across every course. PER_COURSE counts only within the specific
// course being registered for, so a teacher can use the same code once per
// course rather than once ever.
enum PromoCodeTeacherLimitScope {
  ALL_COURSES
  PER_COURSE
}

enum CampaignEmailType {
  REMINDER
  ZOOM_LINK
  UPDATE
  CUSTOM
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

// How a Subscriber's current SUBSCRIBED state came to exist — set when a
// row is created and again on any UNSUBSCRIBED -> SUBSCRIBED transition.
// Left untouched when an already-SUBSCRIBED teacher simply reaffirms
// consent (see ConsentEvent for that full history instead).
enum ConsentSource {
  TRAINING_REGISTRATION
  ADMIN_MANUAL
  MIGRATED
  LANDING_PAGE
}

enum ConsentEventType {
  SUBSCRIBED
  UNSUBSCRIBED
  RESUBSCRIBED
}

enum ConsentEventSource {
  TRAINING_REGISTRATION
  UNSUBSCRIBE_LINK
  ADMIN_MANUAL
  MIGRATED
  LANDING_PAGE
}

// Who performed a manual status change on a Subscriber outside the normal
// registration/unsubscribe-link flows. Nullable — null means the current
// status was never manually overridden by an administrator.
enum SubscriberStatusChangedBy {
  ADMIN
}

model Course {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  shortDescription     String
  fullDescription      String
  category             CourseCategory
  // The start date for a multi-day course — no existing meaning changes for
  // a single-day course, which this remains the sole date for.
  courseDate           DateTime       @db.Date
  startTime            DateTime       @db.Time
  endTime              DateTime       @db.Time
  durationMinutes      Int
  // Multi-day course support (additive). endDate is null for every
  // single-day course; isMultiDay is the server-derived, authoritative flag
  // (see courseFormSchema/toCourseData) — never trusted verbatim from the
  // form. A multi-day course still stores a durationMinutes value (the
  // column stays NOT NULL, unchanged) but it is server-computed from
  // startTime/endTime rather than admin-entered — see toCourseData.
  endDate              DateTime?      @db.Date
  isMultiDay           Boolean        @default(false)
  deliveryMethod       DeliveryMethod
  location             String?
  joiningInstructions  String?
  feeAmount            Decimal        @default(0) @db.Decimal(10, 2)
  currency             String         @default("EGP")
  registrationOpensAt  DateTime?      @db.Timestamptz
  registrationClosesAt DateTime?      @db.Timestamptz
  maxCapacity          Int?
  waitlistEnabled      Boolean        @default(false)
  waitlistCapacity     Int?
  isActive             Boolean        @default(false)
  isFeatured           Boolean        @default(false)
  archivedAt           DateTime?
  // Communication fields — used when sending reminders and joining links to
  // registered teachers (Phase B). Never selected into any public/client-facing
  // course shape; see listPublicCourses in src/lib/training/public-courses.ts.
  zoomLink             String?
  zoomMeetingId        String?
  zoomPasscode         String?
  reminderSubject      String?
  reminderMessage      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  registrations    Registration[]
  promoCodeCourses PromoCodeCourse[]
  emailCampaigns   EmailCampaign[]
  subscribers      Subscriber[]
  consentEvents    ConsentEvent[]

  @@index([isActive])
  @@index([category])
}

model EmailCampaign {
  id             String            @id @default(cuid())
  courseId       String?
  subject        String
  bodyTemplate   String
  emailType      CampaignEmailType
  createdBy      String
  recipientCount Int               @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  course     Course?                  @relation(fields: [courseId], references: [id])
  recipients EmailCampaignRecipient[]

  @@index([courseId])
}

// Delivery audit trail — rows here and on EmailCampaign are append-only and
// must never be hard deleted.
model EmailCampaignRecipient {
  id                String      @id @default(cuid())
  campaignId        String
  teacherId         String
  registrationId    String
  emailAddress      String
  status            EmailStatus @default(PENDING)
  sentAt            DateTime?
  errorMessage      String?
  providerMessageId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign     EmailCampaign @relation(fields: [campaignId], references: [id])
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  registration Registration  @relation(fields: [registrationId], references: [id])

  @@index([campaignId])
  @@index([teacherId])
  @@index([registrationId])
  @@index([status])
}

model Teacher {
  id                 String    @id @default(cuid())
  emailNormalised    String    @unique
  emailOriginal      String
  fullName           String
  phone              String
  phoneNormalised    String
  address            String?
  schoolId           String?
  schoolNameOriginal String
  subjectOriginal    String
  subjectNormalised  String
  gradeOriginal      String
  gradeNormalised    String
  // LEGACY — frozen as of the Subscriber/ConsentEvent model (Phase A of the
  // mailing list feature). Never read this field to decide whether to send
  // marketing email: it is silently overwritten to false whenever a
  // consenting teacher re-registers with the checkbox left unticked, which
  // Subscriber.status deliberately never does. Subscriber.status is the
  // sole authority on marketing-email eligibility going forward. These two
  // columns remain only because existing admin filters, the Excel export
  // and the registration detail screen still read/write them; do not wire
  // any new consumer to them.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  firstRegisteredAt  DateTime
  lastRegisteredAt   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school                  School?                  @relation(fields: [schoolId], references: [id])
  registrations           Registration[]
  emailCampaignRecipients EmailCampaignRecipient[]
  subscriber              Subscriber?

  @@index([schoolId])
}

model School {
  id            String   @id @default(cuid())
  canonicalName String
  nameKey       String   @unique
  schoolType    String?
  location      String?
  mergedIntoId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mergedInto School?       @relation("SchoolMerge", fields: [mergedIntoId], references: [id])
  mergedFrom School[]      @relation("SchoolMerge")
  teachers   Teacher[]
  aliases    SchoolAlias[]
}

model SchoolAlias {
  id        String   @id @default(cuid())
  schoolId  String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Registration {
  id                     String             @id @default(cuid())
  reference              String             @unique
  teacherId              String
  courseId               String
  courseNameSnapshot     String
  courseDateSnapshot     DateTime           @db.Date
  courseFeeSnapshot      Decimal            @db.Decimal(10, 2)
  courseCurrencySnapshot String
  status                 RegistrationStatus
  waitlistPosition       Int?
  promotedAt             DateTime?
  registeredAt           DateTime           @default(now())
  consentGiven           Boolean            @default(false)
  consentAt              DateTime?
  emailSent              Boolean            @default(false)
  emailSentAt            DateTime?
  emailStatus            EmailStatus        @default(PENDING)
  emailType              EmailType
  emailError             String?
  sourceIpHash           String?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // Promo code snapshot (Phase B) — a permanent record of what was applied
  // at the moment of submission or promotion. Once written, never
  // recalculated: editing or archiving the PromoCode row afterwards must
  // never change what a historical registration shows. courseFeeSnapshot
  // above is untouched by any of this; originalFee deliberately duplicates
  // it so this promo record reads correctly in isolation. All null when no
  // promo code was applied.
  promoCodeId           String?
  promoCodeSnapshot     String?
  discountTypeSnapshot  PromoCodeDiscountType?
  discountValueSnapshot Decimal?               @db.Decimal(10, 2)
  discountAmount        Decimal?               @db.Decimal(10, 2)
  originalFee           Decimal?               @db.Decimal(10, 2)
  finalFee              Decimal?               @db.Decimal(10, 2)
  promoAppliedAt        DateTime?              @db.Timestamptz

  teacher                 Teacher                  @relation(fields: [teacherId], references: [id])
  course                  Course                   @relation(fields: [courseId], references: [id])
  promoCode               PromoCode?               @relation(fields: [promoCodeId], references: [id])
  emailCampaignRecipients EmailCampaignRecipient[]

  // Database-level duplicate prevention: at most one registration row per
  // (course, teacher) pair, ever — including across cancellation. A teacher
  // whose registration for a course was cancelled cannot get a second row
  // for that same course; re-registration for that course is not possible
  // at the schema level, by design per spec.
  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
  @@index([registeredAt])
  @@index([status])
  @@index([promoCodeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Uniqueness of `code` is enforced only among non-archived rows — a code
// value can be reused once its original row is archived, per spec. Prisma's
// schema DSL can't express a partial unique index, so `code` is NOT marked
// @unique here; the partial unique index is added by hand in this model's
// migration.sql (CREATE UNIQUE INDEX ... WHERE "archivedAt" IS NULL), and
// application code performs its own non-archived uniqueness check before
// writing, backed by that index as a race-condition safety net. Never hard
// delete a row here — archive via archivedAt so historical registrations
// (once Phase B references promo codes) can always resolve it.
model PromoCode {
  id                     String                     @id @default(cuid())
  code                   String
  description            String
  discountType           PromoCodeDiscountType
  discountValue          Decimal                    @db.Decimal(10, 2)
  currency               String                     @default("EGP")
  appliesToAllCourses    Boolean                    @default(false)
  startsAt               DateTime?                  @db.Timestamptz
  expiresAt              DateTime?                  @db.Timestamptz
  maxTotalUses           Int?
  maxUsesPerTeacher      Int                        @default(1)
  maxUsesPerTeacherScope PromoCodeTeacherLimitScope @default(ALL_COURSES)
  isPaused               Boolean                    @default(false)
  archivedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  courses       PromoCodeCourse[]
  registrations Registration[]

  @@index([code])
  @@index([archivedAt])
  @@index([startsAt])
  @@index([expiresAt])
}

model PromoCodeCourse {
  id          String   @id @default(cuid())
  promoCodeId String
  courseId    String
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])

  @@unique([promoCodeId, courseId])
  @@index([promoCodeId])
  @@index([courseId])
}

// Mailing list (Phase A): the sole authority on whether a teacher can be
// sent marketing email. Never hard delete a row — unsubscribing changes
// status only, so the row (and its unsubscribeToken) persists for the life
// of the teacher. See the LEGACY note on Teacher.marketingConsent: that
// field must never be consulted in place of this one.
model Subscriber {
  id                    String                     @id @default(cuid())
  // Nullable — a landing page subscriber (Phase C) has no teacher and no
  // course. When that person later registers for a course, this is set to
  // link the existing row rather than creating a second subscriber; their
  // subscribedAt and consent history are preserved. @unique still allows
  // any number of NULL rows in Postgres, so many un-linked subscribers can
  // coexist.
  teacherId             String?                    @unique
  emailNormalised       String                     @unique
  // Populated only for subscribers with no teacherId (fullName/email are
  // otherwise read from the linked Teacher, which is always the fresher,
  // authoritative source once a subscriber is linked).
  fullName              String?
  emailOriginal         String?
  status                SubscriberStatus
  subscribedAt          DateTime                   @db.Timestamptz
  unsubscribedAt        DateTime?                  @db.Timestamptz
  consentSource         ConsentSource
  consentCourseId       String?
  consentWordingVersion String
  // Cryptographically random (>=32 bytes), URL-safe, never derived from
  // email/teacherId/any sequential value — generated once at creation and
  // kept for the life of the record. Holding a token unsubscribes only the
  // one matching row. Never expose this in analytics, logs or any export.
  unsubscribeToken      String                     @unique
  lastMarketingEmailAt  DateTime?
  marketingEmailsSent   Int                        @default(0)
  statusChangedBy       SubscriberStatusChangedBy?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  teacher                     Teacher?                     @relation(fields: [teacherId], references: [id])
  consentCourse               Course?                      @relation(fields: [consentCourseId], references: [id])
  consentEvents               ConsentEvent[]
  marketingCampaignRecipients MarketingCampaignRecipient[]

  @@index([status])
  @@index([subscribedAt])
  @@index([consentCourseId])
}

// Append-only audit trail of every consent change — evidence if a
// teacher's consent is ever challenged. Application code must never
// update or delete a row here.
model ConsentEvent {
  id             String             @id @default(cuid())
  subscriberId   String
  eventType      ConsentEventType
  source         ConsentEventSource
  courseId       String?
  wordingVersion String?
  ipHash         String?
  occurredAt     DateTime           @db.Timestamptz
  createdAt      DateTime           @default(now())

  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])

  @@index([subscriberId])
  @@index([courseId])
  @@index([occurredAt])
}

// Marketing email templates (Phase C) — administrator-authored starting
// points for the composer, never auto-sent. Never hard deleted: archive via
// archivedAt so a template referenced by anything in the future can always
// resolve.
model MarketingTemplate {
  id           String    @id @default(cuid())
  name         String
  subject      String
  bodyTemplate String
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaigns MarketingCampaign[]

  @@index([archivedAt])
}

enum MarketingRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_UNSUBSCRIBED
}

// Mailing list (Phase D): one row per real send of a marketing email to the
// Subscriber list. templateId records which MarketingTemplate the
// administrator started from, if any — subject/bodyTemplate below are always
// the actual content sent, a permanent snapshot independent of any later
// edit or archive of that template. Never hard deleted.
model MarketingCampaign {
  id             String   @id @default(cuid())
  subject        String
  bodyTemplate   String
  templateId     String?
  createdBy      String
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  skippedCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template   MarketingTemplate?           @relation(fields: [templateId], references: [id])
  recipients MarketingCampaignRecipient[]

  @@index([templateId])
  @@index([createdAt])
}

// Delivery audit trail for marketing sends — append-only, never hard
// deleted, mirroring EmailCampaignRecipient's role for the transactional
// bulk-email feature. Keyed by subscriberId (not teacherId/registrationId)
// since a landing page subscriber has neither. A row is written PENDING for
// every resolved recipient before any send is attempted, so the manifest
// survives a crash and shows who was queued.
model MarketingCampaignRecipient {
  id                String                   @id @default(cuid())
  campaignId        String
  subscriberId      String
  emailAddress      String
  status            MarketingRecipientStatus @default(PENDING)
  sentAt            DateTime?
  errorMessage      String?
  providerMessageId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id])
  subscriber Subscriber        @relation(fields: [subscriberId], references: [id])

  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
}
